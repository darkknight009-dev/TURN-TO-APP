# Public URL users should receive in generated Install / open links.
PUBLIC_APP_URL=https://your-converter-domain.com

# Required for shared multi-instance/serverless storage.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=pwa_converter
MONGODB_COLLECTION=pwas
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Local/single-host fallback storage.
PWA_STORE_PATH=.data/pwas.json
